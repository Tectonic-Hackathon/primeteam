    {
      "id": "be-cutoff-v3",
      "file": "be-cutoff-v3.md",
      "type": "procedure",
      "topic": "cutoff",
      "title": "Payroll change cutoff procedure, Belgium (v3)",
      "status": "approved",
      "country": "Belgium",
      "domain": "Pay",
      "owner": "Lotte Vermeulen",
      "effective_from": "2025-05-12",
      "effective_until": null,
      "family": "be-cutoff",
      "version": "3.0",
      "supersedes": "be-cutoff-v1",
      "spans": [
        {
          "text": "For Belgian payrolls, all payroll changes must reach SD Worx at the latest 5 working days before payday.",
          "component": "payroll change deadline",
          "claim_value": "5_working_days"
        },
        {
          "text": "Payroll changes received after the cutoff are processed in the next payroll run.",
          "component": "late changes",
          "claim_value": "next_run"
        },
        {
          "text": "A correction run can be requested for the current month and is charged separately.",
          "component": "correction run",
          "claim_value": "charged"
        },
        {
          "text": "Only urgent terminations with a final pay obligation can be processed after the cutoff, with approval from the team lead.",
          "component": "exceptions",
          "claim_value": "urgent_terminations_team_lead"
        },
        {
          "text": "Questions about the Belgian payroll cutoff procedure go to Lotte Vermeulen, Payroll Operations Belgium.",
          "component": "contact person",
          "claim_value": "lotte"
        }
      ]
    },
    {
