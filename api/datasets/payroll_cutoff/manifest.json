    {
      "id": "be-knowledge-governance",
      "file": "be-knowledge-governance.md",
      "type": "policy",
      "topic": "general",
      "title": "Knowledge governance policy, Belgium",
      "status": "approved",
      "country": "Belgium",
      "domain": "Pay",
      "owner": "Eva Claes",
      "effective_from": "2025-01-15",
      "effective_until": null,
      "family": "be-knowledge-governance",
      "version": "2.0",
      "supersedes": null,
      "spans": [
        {
          "text": "When an FAQ or guide contradicts an official payroll procedure, the official procedure is leading.",
          "component": "source_hierarchy",
          "claim_value": "procedure_leads"
        },
        {
          "text": "Documents without an owner or date are never an official source.",
          "component": "unofficial_sources",
          "claim_value": "no_owner_not_official"
        },
        {
          "text": "When two sources conflict, the owner of the official procedure decides which information is correct.",
          "component": "who_decides",
          "claim_value": "procedure_owner"
        },
        {
          "text": "The owner of the conflicting document must update it within 10 working days.",
          "component": "update_deadline",
          "claim_value": "10_working_days"
        },
        {
          "text": "When a document owner leaves the company, ownership moves to their team lead.",
          "component": "owner_leaves",
          "claim_value": "team_lead"
        },
        {
          "text": "Old versions must be archived when a new version is published.",
          "component": "archiving",
          "claim_value": "archive_old"
        },
        {
          "text": "If no document exists for a question, employees contact the relevant country expert, who captures the answer in a new document.",
          "component": "missing_knowledge",
          "claim_value": "country_expert_captures"
        }
      ]
    },
